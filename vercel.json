{
  "functions": {
    "api/upload-factura.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/CEVER/fx/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/CEVER/fx-m/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/CEVER/logo-btg-blanco.png",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "redirects": [
    { "source": "/susi", "destination": "/#tecnologia", "permanent": false },
    { "source": "/bolsadetrabajo", "destination": "/bolsa-de-trabajo.html", "permanent": false },
    { "source": "/boletines", "destination": "/boletines.html", "permanent": false },
    { "source": "/directorio-btg", "destination": "/directorio.html", "permanent": false },
    { "source": "/convenciones", "destination": "/convenciones.html", "permanent": false },
    { "source": "/biblioteca-digital", "destination": "/biblioteca-digital.html", "permanent": false },
    { "source": "/cever", "destination": "/cever.html", "permanent": false }
  ]
}
